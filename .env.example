# 生产由 systemd EnvironmentFile 注入；不提交真实值。
ALERTOPS_MYSQL_DSN=alertops:CHANGE_ME@tcp(127.0.0.1:3306)/alertops
ALERTOPS_NODE_ID=1
ALERTOPS_SESSION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ALERTOPS_BASE_URL=https://alerts.example.com
ALERTOPS_BOOTSTRAP_UNION_ID=EXPLICIT_VERIFIED_ADMIN_UNION_ID
DINGTALK_CORP_ID=YOUR_CORP_ID
DINGTALK_APP_ID=YOUR_APP_KEY
DINGTALK_APP_SECRET=YOUR_APP_SECRET
DINGTALK_COOL_APP_CODE=YOUR_COOL_APP_CODE
DINGTALK_TEMPLATE_LOG=YOUR_PUBLISHED_LOG_TEMPLATE.schema
DINGTALK_TEMPLATE_METRIC=YOUR_PUBLISHED_METRIC_TEMPLATE.schema
DINGTALK_TEMPLATE_NOTICE=YOUR_PUBLISHED_NOTICE_TEMPLATE.schema
DINGTALK_TEMPLATE_TOPBOX=YOUR_PUBLISHED_TOPBOX_TEMPLATE.schema
CODEUP_TOKEN=YOUR_CODEUP_PERSONAL_ACCESS_TOKEN
CODEUP_HOOK_TOKEN=YOUR_RANDOM_HOOK_TOKEN
ALERTOPS_ARTIFACT_ROOT=/srv/alertops/artifacts
ALERTOPS_RUNNER_CALLBACK_URL=https://alerts.example.com
# 管理页面只填写下面这些名称，真实值由部署环境提供。
LOG_HOOK_SECRET=YOUR_LOG_SOURCE_SECRET
METRIC_HOOK_SECRET=YOUR_METRIC_SOURCE_SECRET
PROJECT_CODEX_API_KEY=YOUR_CODEX_EXEC_API_KEY
PROJECT_GIT_TOKEN=YOUR_CODEUP_GIT_TOKEN
